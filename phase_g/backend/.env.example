# .env.example (Phase G backend)
# --------------------------------
# Copy to .env in this same folder. Never commit .env to git.

# Same Postgres instance phase_c/backend uses (see phase_c/backend/.env.example
# and docker-compose.yml) -- Phase G does not introduce a second database.
DATABASE_URL=postgresql+psycopg://invigilator:dev_password_change_in_production@localhost:5432/study_invigilator

# Required for the LLM reasoning layer (llm/client.py). Get a real key
# from https://console.anthropic.com. If unset, /recommendation still
# works -- it falls back to a plain, deterministic sentence (see
# routes.py's fallback_report()) instead of failing the request.
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# Must match phase_c/backend's JWT_SECRET if you want a single shared
# .env across both -- functionally only this backend's auth.py reads it.
JWT_SECRET=change_this_to_a_long_random_string

# The deployed (or local dev) React frontend's origin, for CORS -- see
# main.py and docs/03_DEPLOYMENT_GUIDE.txt Part 1 Step 5.
FRONTEND_ORIGIN=http://localhost:5173

ENVIRONMENT=development
