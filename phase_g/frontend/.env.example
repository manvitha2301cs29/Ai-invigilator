# .env.example (Phase G frontend)
# --------------------------------
# Copy to .env.local for local dev (Vite auto-loads .env.local, never
# commit it). For deployment, set this as a build-time environment
# variable on your static host (Vercel/Netlify/Railway/Render) --
# see docs/03_DEPLOYMENT_GUIDE.txt Part 1 Step 4.

VITE_API_URL=http://localhost:8000
