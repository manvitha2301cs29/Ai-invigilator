# .env.example_PHASE_C
# ----------------------
# Copy this to .env (same folder) and fill in real values. .env must
# NEVER be committed to git -- add it to .gitignore now if you haven't.

# Matches docker-compose_PHASE_C.yml's postgres service by default.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://invigilator:dev_password_change_in_production@localhost:5432/study_invigilator

# Get a real key from https://console.anthropic.com -- used in Phase G
# for the LLM reasoning layer, not needed yet in Phase C but included
# here so your .env file is complete from the start.
ANTHROPIC_API_KEY=your_key_here

# Generate a long random string for signing auth tokens, e.g. in
# PowerShell: -join ((48..57)+(65..90)+(97..122)|Get-Random -Count 48|%{[char]$_})
JWT_SECRET=change_this_to_a_long_random_string

ENVIRONMENT=development
